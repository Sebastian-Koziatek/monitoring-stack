# =============================================================================
#  Hasła i parametry stacku szkoleniowego
#  UWAGA: to są PROSTE hasła dla środowiska szkoleniowego — w produkcji zmień!
# =============================================================================

# --- Elasticsearch / Kibana --------------------------------------------------
ELASTIC_PASSWORD=Elastic123!
KIBANA_SYSTEM_PASSWORD=KibanaSystem123!
# Użytkownik dla uczestników szkolenia (rola superuser)
TRAINING_USER=szkolenie
TRAINING_PASSWORD=szkolenie
# Klucz szyfrowania Kibany (min. 32 znaki) — wymagany przez Fleet/Integrations
KIBANA_ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90
KIBANA_PUBLIC_URL=http://localhost:5601
# Rozmiar sterty JVM Elasticsearcha (nie więcej niż 50% RAM hosta)
ES_HEAP_SIZE=1g

# --- Grafana -----------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- InfluxDB 2.x ------------------------------------------------------------
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=Influx123!
INFLUX_ORG=myorg
INFLUX_BUCKET=telegraf
# Token all-access tworzony automatycznie przy pierwszym starcie
INFLUX_TOKEN=szkolenie-influx-token-0123456789

# --- Zabbix / MariaDB --------------------------------------------------------
DB_ROOT_PASSWORD=ZabbixRoot123!
DB_ZABBIX_PASSWORD=ZabbixDB123!
